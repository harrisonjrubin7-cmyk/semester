{
  "name": "semester",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root. Holds app/ and packages/* with one lockfile; application commands run from app/, while the root exposes only platform-control registry commands.",
  "workspaces": [
    "app",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "registry:validate": "npm run validate --workspace @semester/platform-control",
    "registry:build": "npm run build:registry --workspace @semester/platform-control",
    "release:check": "npm run check:release --workspace @semester/platform-control",
    "platform-control:test": "npm test --workspace @semester/platform-control"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "dompurify": "3.4.16",
    "katex": "0.18.2",
    "source-map-js": "1.2.2"
  }
}
