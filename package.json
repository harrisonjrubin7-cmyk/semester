{
  "name": "semester",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root. Holds app/ and packages/* as npm workspaces with one lockfile; video/ and pipeline/ keep their own manifests and lockfiles (see docs/target-architecture/09-CONVERSION-PLAN.md, wave C0). Product scripts run from app/; platform-control scripts run here.",
  "workspaces": [
    "app",
    "packages/*",
    "operator"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "registry:validate": "npm run validate --workspace @semester/platform-control",
    "registry:build": "npm run build:registry --workspace @semester/platform-control",
    "release:check": "npm run check:release --workspace @semester/platform-control",
    "release:report": "npm run report:release --workspace @semester/platform-control",
    "platform-control:test": "npm test --workspace @semester/platform-control",
    "operator:typecheck": "npm run typecheck --workspace @semester/operator",
    "operator:test": "npm test --workspace @semester/operator",
    "operator:build": "npm run build --workspace @semester/operator",
    "operator:demo": "npm run demo --workspace @semester/operator",
    "operator": "npm run operator --workspace @semester/operator --"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "dompurify": "3.4.16",
    "katex": "0.18.2",
    "source-map-js": "1.2.2"
  },
  "devDependencies": {
    "yaml": "^2.8.3"
  }
}
