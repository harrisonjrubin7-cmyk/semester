 "_comment": "Table classification register. Source of truth for database/DATA_CLASSIFICATION_REGISTER.md. A new table must be added here in the same pull request (app/src/lib/tableclassification.test.ts). Classes are derived from production's catalog and have NOT been human-reviewed table by table: see 'basis'.",
 "measuredAt": "2026-10-04",
 "source": "production catalog, schemas public and private, read-only (database/schema/inventory.sql queries 1 and 7)",
 "basis": {
  "global-public": "anon can SELECT and a read policy admits rows without identity (catalog data)",
  "global-reference": "authenticated can SELECT, read policy is true, no tenant or owner column (role/capability reference data)",
  "person-private": "owner column present and policies key on auth.uid()",
  "parent-scoped": "read policy is an EXISTS on a parent table, so it inherits the parent's RLS",
  "relationship-scoped": "policies call a capability/membership/relationship helper (private.*)",
  "tenant-scoped": "has school_id, tenant_id or institution_id and at least one policy. Takes precedence over person-private, so profiles and organizations land here",
  "service-only": "no SELECT or write grant for anon or authenticated; reached only through definer functions or the service role",
  "view": "security_invoker view"
 },
