{
  "name": "semester",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "semester",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "node_modules/@semester/contract": {
      "resolved": "packages/contract",
      "link": true
    },
    "node_modules/@semester/institution": {
      "resolved": "packages/institution",
      "link": true
    },
    "packages/contract": {
      "name": "@semester/contract",
      "version": "1.0.0"
    },
    "packages/institution": {
      "name": "@semester/institution",
      "version": "1.0.0"
    }
  }
}
