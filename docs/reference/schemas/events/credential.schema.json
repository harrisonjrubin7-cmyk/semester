{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semester:events:credential",
  "title": "Semester events: Credential",
  "description": "The 5 Credential event types. Each branch fixes the type name and version and allows the classifications at or above the type's floor. Generated from EVENT_TYPES in packages/institution/src/events.ts.",
  "allOf": [
    {
      "$ref": "urn:semester:events:envelope"
    }
  ],
  "oneOf": [
    {
      "title": "evidence.added",
      "properties": {
        "eventType": {
          "const": "evidence.added"
        },
        "eventVersion": {
          "const": 1
        },
        "dataClassification": {
          "enum": [
            "student_private",
            "education_record"
          ]
        },
        "retentionClass": {
          "description": "The catalog declares student_record for this type. validateEvent does not compare it.",
          "x-semesterCatalogRetention": "student_record"
        }
      }
    },
    {
      "title": "verification.requested",
      "properties": {
        "eventType": {
          "const": "verification.requested"
        },
        "eventVersion": {
          "const": 1
        },
        "dataClassification": {
          "enum": [
            "student_private",
            "education_record"
          ]
        },
        "retentionClass": {
          "description": "The catalog declares audit for this type. validateEvent does not compare it.",
          "x-semesterCatalogRetention": "audit"
        }
      }
    },
    {
      "title": "verification.approved",
      "properties": {
        "eventType": {
          "const": "verification.approved"
        },
        "eventVersion": {
          "const": 1
        },
        "dataClassification": {
          "enum": [
            "student_private",
            "education_record"
          ]
        },
        "retentionClass": {
          "description": "The catalog declares audit for this type. validateEvent does not compare it.",
          "x-semesterCatalogRetention": "audit"
        }
      }
    },
    {
      "title": "credential.issued",
      "properties": {
        "eventType": {
          "const": "credential.issued"
        },
        "eventVersion": {
          "const": 1
        },
        "dataClassification": {
          "enum": [
            "student_private",
            "education_record"
          ]
        },
        "retentionClass": {
          "description": "The catalog declares audit for this type. validateEvent does not compare it.",
          "x-semesterCatalogRetention": "audit"
        }
      }
    },
    {
      "title": "credential.revoked",
      "properties": {
        "eventType": {
          "const": "credential.revoked"
        },
        "eventVersion": {
          "const": 1
        },
        "dataClassification": {
          "enum": [
            "student_private",
            "education_record"
          ]
        },
        "retentionClass": {
          "description": "The catalog declares audit for this type. validateEvent does not compare it.",
          "x-semesterCatalogRetention": "audit"
        }
      }
    }
  ]
}
