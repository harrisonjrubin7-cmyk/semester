{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semester:events:integration",
  "title": "Semester events: Integration",
  "description": "The 6 Integration event types. Each branch fixes the type name and version and allows the classifications at or above the type's floor. Generated from EVENT_TYPES in packages/institution/src/events.ts.",
