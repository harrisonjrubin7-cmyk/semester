      "title": "connector.sync_started",
      "properties": {
        "eventType": {
          "const": "connector.sync_started"
        },
        "eventVersion": {
          "const": 1
        },
        "dataClassification": {
          "enum": [
            "internal",
            "student_private",
            "education_record"
          ]
        },
        "retentionClass": {
          "description": "The catalog declares operational for this type. validateEvent does not compare it.",
