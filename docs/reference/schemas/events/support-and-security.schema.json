{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semester:events:support-and-security",
  "title": "Semester events: Support and security",
  "description": "The 7 Support and security event types. Each branch fixes the type name and version and allows the classifications at or above the type's floor. Generated from EVENT_TYPES in packages/institution/src/events.ts.",
  "allOf": [
    {
      "$ref": "urn:semester:events:envelope"
    }
  ],
  "oneOf": [
    {
      "title": "support.ticket_created",
      "properties": {
        "eventType": {
          "const": "support.ticket_created"
        },
        "eventVersion": {
          "const": 1
        },
        "dataClassification": {
          "enum": [
            "student_private",
            "education_record"
          ]
        },
        "retentionClass": {
          "description": "The catalog declares operational for this type. validateEvent does not compare it.",
          "x-semesterCatalogRetention": "operational"
        }
      }
