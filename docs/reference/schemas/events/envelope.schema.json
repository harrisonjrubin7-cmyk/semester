{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semester:events:envelope",
  "title": "SemesterEvent envelope",
  "description": "The envelope every event carries. Mirrors validateEvent in packages/institution/src/events.ts, rule for rule; generated by app/src/lib/docs/platform-reference.test.ts.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "producer",
    "environment",
    "correlationId",
    "dataClassification",
    "retentionClass",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "eventType": {
      "type": "string",
      "pattern": "^[a-z_]+\\.[a-z_]+$",
      "enum": [
        "identity.user_registered",
        "identity.session_authenticated",
        "identity.role_granted",
        "identity.role_revoked",
        "action.created",
        "action.updated",
        "action.completed",
        "plan.updated",
        "task.created",
        "task.updated",
        "task.completed",
        "task.deleted",
        "calendar_event.created",
        "calendar_event.updated",
        "calendar_event.deleted",
        "productivity.shared_read",
        "agenda.shared",
        "share.revoked",
        "course.published",
        "assignment.created",
        "submission.draft_saved",
        "submission.finalized",
        "assessment.started",
        "assessment.autosaved",
        "assessment.recovered",
        "grade.posted",
        "grade.passback_requested",
        "grade.passback_reconciled",
        "connector.sync_started",
        "connector.sync_completed",
        "connector.sync_failed",
        "source.updated",
        "source.stale",
        "reconciliation.discrepancy_detected",
        "ai.requested",
        "ai.policy_blocked",
        "ai.retrieval_completed",
        "ai.response_completed",
        "ai.feedback_submitted",
        "ai.incident_detected",
        "ai.kill_switch_changed",
        "registration.readiness_viewed",
        "registration.override_requested",
        "registration.override_granted",
        "support.ticket_created",
        "support.access_granted",
        "support.access_revoked",
        "support.context_read",
        "security.alert_opened",
        "incident.declared",
        "incident.resolved",
        "tenant_rollout.changed",
        "subscription.activated",
        "entitlement.changed",
        "invoice.paid",
        "payment.failed",
        "renewal.started",
        "evidence.added",
        "verification.requested",
        "verification.approved",
        "credential.issued",
        "credential.revoked"
      ]
    },
    "eventVersion": {
      "type": "integer",
      "minimum": 1
    },
    "occurredAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "environment": {
      "enum": [
        "production",
        "staging",
        "demo"
      ]
    },
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "customerAccountId": {
      "description": "Typed as a string in SemesterEvent. validateEvent does not check it, so neither does this schema."
    },
    "actor": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "description": "Typed as an actor type in SemesterEvent. validateEvent checks only the length."
        }
      }
    },
    "subject": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]{8,128}$"
    },
    "causationId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "maxLength": 200
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "dataClassification": {
      "enum": [
        "public",
        "internal",
        "student_private",
        "education_record"
      ]
    },
    "retentionClass": {
      "enum": [
        "operational",
        "student_record",
        "audit",
        "commercial"
      ]
    },
    "payload": {
      "type": "object"
    }
  }
}
