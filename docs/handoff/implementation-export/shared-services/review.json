[
  {
    "id": "shared.identity.signin",
    "purpose": "Authenticate through verified provider and recover access",
    "boundary": "Identity service only; browser cannot assign actor or tenant",
    "negative_tests": [
      "Bad token/provider",
      "recovery abuse",
      "revoked session"
    ],
    "routes": [
      "/auth/signin",
      "/auth/mfa",
      "/auth/recover"
    ],
    "actors": [
      "any"
    ],
    "permissions": [
      "session.create"
    ],
    "records": [
      "auth.users",
      "onboard.devices"
    ],
    "commands": [
      "sign_in",
      "verify_mfa"
    ],
    "events": [
      "session.started"
    ],
    "status": "source-declared; live implementation not assessed"
  },
  {
    "id": "shared.identity.sessions",
