{
  "openapi": "3.1.0",
  "info": {
    "title": "Semester Student Lifecycle, Consent and Disclosure Accounting Draft API",
    "version": "0.2.0",
    "description": "Standalone proposed extension to the prior sync contract; no deployed endpoints asserted."
  },
  "paths": {
    "/v1/consents": {
      "post": {
        "operationId": "createSignedConsent",
        "description": "Server authenticates signer, signer authority and approval challenge; assigns signature evidence and signed time.",
        "security": [
          {
            "userToken": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 200
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsentIntent"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Confirmed local result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsentRecord"
                }
              }
            }
          },
          "default": {
            "description": "Safe error without sensitive record content",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/consents/{consentId}/revocations": {
      "post": {
        "operationId": "revokeConsent",
        "description": "200 only after local revocation and authorization epoch bump commit; downstream cleanup may remain pending.",
        "security": [
          {
            "userToken": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 200
            }
          },
          {
            "name": "consentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RevocationIntent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Confirmed local result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevocationReceipt"
                }
              }
            }
          },
          "default": {
            "description": "Safe error without sensitive record content",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/student-transitions": {
      "post": {
        "operationId": "commitAuthorizedTransition",
        "description": "Native authorized commit only. Externally authoritative transitions use a separate asynchronous request and source confirmation workflow.",
        "security": [
          {
            "userToken": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 200
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransitionIntent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Confirmed local result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransitionReceipt"
                }
              }
            }
          },
          "default": {
            "description": "Safe error without sensitive record content",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/subjects/{subjectId}/disclosure-records": {
      "get": {
        "operationId": "listPermittedDisclosureRecords",
        "security": [
          {
            "userToken": []
          }
        ],
        "parameters": [
          {
            "name": "subjectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "institutionId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 1000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Rights-reviewed accounting records, not raw security logs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DisclosurePage"
                }
              }
            }
          },
          "default": {
            "description": "Safe error without sensitive record content",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "userToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ConsentIntent": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "institutionId": {
            "type": "string",
            "format": "uuid"
          },
          "subjectId": {
            "type": "string",
            "format": "uuid"
          },
          "recordScope": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "recipientScope": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "consentTextVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "approvalChallengeId": {
            "type": "string",
            "format": "uuid"
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "institutionId",
          "subjectId",
          "recordScope",
          "purpose",
          "recipientScope",
          "consentTextVersion",
          "approvalChallengeId",
          "expiresAt"
        ]
      },
      "ConsentRecord": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "consentId": {
            "type": "string",
            "format": "uuid"
          },
          "intent": {
            "$ref": "#/components/schemas/ConsentIntent"
          },
          "signerId": {
            "type": "string",
            "format": "uuid"
          },
          "signerAuthorityEvidenceId": {
            "type": "string",
            "format": "uuid"
          },
          "signatureEvidenceId": {
            "type": "string",
            "format": "uuid"
          },
          "signedAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "enum": [
              "active",
              "expired",
              "revoked",
              "superseded"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "revokedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "authorizationEpoch": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "consentId",
          "intent",
          "signerId",
          "signerAuthorityEvidenceId",
          "signatureEvidenceId",
          "signedAt",
          "status",
          "revision",
          "revokedAt",
          "authorizationEpoch"
        ]
      },
      "RevocationIntent": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expectedRevision": {
            "type": "integer",
            "minimum": 1
          },
          "reasonCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "expectedRevision"
        ]
      },
      "RevocationReceipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "consentId": {
            "type": "string",
            "format": "uuid"
          },
          "effectiveAt": {
            "type": "string",
            "format": "date-time"
          },
          "authorizationEpoch": {
            "type": "integer",
            "minimum": 1
          },
          "localStatus": {
            "const": "revoked"
          },
          "cleanupStatus": {
            "enum": [
              "pending",
              "complete",
              "escalated"
            ]
          }
        },
        "required": [
          "requestId",
          "consentId",
          "effectiveAt",
          "authorizationEpoch",
          "localStatus",
          "cleanupStatus"
        ]
      },
      "TransitionIntent": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "relationshipId": {
            "type": "string",
            "format": "uuid"
          },
          "machine": {
            "enum": [
              "admissions",
              "academic_relationship",
              "completion",
              "alumni"
            ]
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 1
          },
          "fromState": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "toState": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "effectiveAt": {
            "type": "string",
            "format": "date-time"
          },
          "authorityEvidenceId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "relationshipId",
          "machine",
          "expectedRevision",
          "fromState",
          "toState",
          "effectiveAt",
          "authorityEvidenceId"
        ]
      },
      "TransitionReceipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "transitionId": {
            "type": "string",
            "format": "uuid"
          },
          "relationshipId": {
            "type": "string",
            "format": "uuid"
          },
          "machine": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "fromState": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "toState": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "effectiveAt": {
            "type": "string",
            "format": "date-time"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "policyDecisionId": {
            "type": "string",
            "format": "uuid"
          },
          "authorityEvidenceId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "transitionId",
          "relationshipId",
          "machine",
          "fromState",
          "toState",
          "effectiveAt",
          "recordedAt",
          "revision",
          "policyDecisionId",
          "authorityEvidenceId"
        ]
      },
      "DisclosureAccountingRecord": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "institutionId": {
            "type": "string",
            "format": "uuid"
          },
          "subjectId": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "enum": [
              "request",
              "disclosure",
              "further_disclosure"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "recordRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "partyIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "legitimateInterest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "legalBasisCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "basisEvidenceId": {
            "type": "string",
            "format": "uuid"
          },
          "policyDecisionId": {
            "type": "string",
            "format": "uuid"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "accountingDisposition": {
            "enum": [
              "required",
              "exception_applies",
              "review_required"
            ]
          },
          "dispositionRuleVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "emergencyThreatEvidenceId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "supersedesId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        },
        "required": [
          "id",
          "institutionId",
          "subjectId",
          "kind",
          "occurredAt",
          "recordRefs",
          "partyIds",
          "legitimateInterest",
          "legalBasisCode",
          "basisEvidenceId",
          "policyDecisionId",
          "correlationId",
          "accountingDisposition",
          "dispositionRuleVersion",
          "emergencyThreatEvidenceId",
          "supersedesId"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "legalBasisCode": {
                  "const": "ferpa.health_safety_emergency"
                }
              },
              "required": [
                "legalBasisCode"
              ]
            },
            "then": {
              "properties": {
                "emergencyThreatEvidenceId": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        ]
      },
      "SecurityAuditRecord": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "institutionId": {
            "type": "string",
            "format": "uuid"
          },
          "actorId": {
            "type": "string",
            "format": "uuid"
          },
          "subjectId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "resourceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "maxItems": 100
          },
          "outcome": {
            "enum": [
              "allowed",
              "denied",
              "failed",
              "unknown"
            ]
          },
          "policyDecisionId": {
            "type": "string",
            "format": "uuid"
          },
          "basisEvidenceId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id",
          "institutionId",
          "actorId",
          "subjectId",
          "action",
          "resourceRefs",
          "outcome",
          "policyDecisionId",
          "basisEvidenceId",
          "recordedAt",
          "correlationId"
        ]
      },
      "EventPointer": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "eventType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "schemaVersion": {
            "const": "1"
          },
          "institutionId": {
            "type": "string",
            "format": "uuid"
          },
          "aggregateId": {
            "type": "string",
            "format": "uuid"
          },
          "aggregateSequence": {
            "type": "integer",
            "minimum": 1
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "recordRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "authorizationEpoch": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "eventId",
          "eventType",
          "schemaVersion",
          "institutionId",
          "aggregateId",
          "aggregateSequence",
          "occurredAt",
          "correlationId",
          "recordRef",
          "authorizationEpoch"
        ]
      },
      "DisclosurePage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DisclosureAccountingRecord"
            },
            "maxItems": 100
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "retryable": {
            "type": "boolean"
          },
          "outcomeUnknown": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "correlationId",
          "retryable",
          "outcomeUnknown"
        ]
      }
    }
  }
}