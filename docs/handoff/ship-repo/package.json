{
  "name": "semester",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "vitest run --dir packages",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:rls": "vitest run scripts/verify/rls.test.ts",
    "test:policy": "opa test packages/policy -v",
    "test:workflow": "vitest run packages/workflow-engine",
    "test:contracts": "vitest run scripts/verify/contracts.test.ts",
    "test:a11y": "playwright test --project accessibility",
    "test:tenant-isolation": "vitest run scripts/verify/tenant-isolation.test.ts",
    "test:source-authority": "vitest run scripts/verify/source-authority.test.ts",
    "test:provenance": "vitest run scripts/verify/provenance.test.ts",
    "test:ai-boundaries": "vitest run scripts/verify/ai-boundaries.test.ts",
    "test:release-gate": "tsx scripts/release/check-gate.ts",
    "registry:validate": "tsx scripts/registry/validate.ts",
    "db:migrate": "supabase migration up",
    "db:reset": "supabase db reset",
    "db:seed:safe": "tsx scripts/fixtures/seed-safe.ts",
    "evidence:collect": "tsx scripts/release/collect-evidence.ts",
    "release:preview": "tsx scripts/release/preview.ts",
    "release:approve": "tsx scripts/release/approve.ts",
    "flags:enable": "tsx scripts/release/flags.ts enable",
    "flags:disable": "tsx scripts/release/flags.ts disable",
    "verify:first-live-journey": "playwright test e2e/first-live-journey.spec.ts",
    "incidents:create": "tsx scripts/ops/create-incident.ts"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@playwright/test": "^1.48.0",
    "tsx": "^4.19.0",
    "yaml": "^2.6.0",
    "@supabase/supabase-js": "^2.45.4"
  }
}
