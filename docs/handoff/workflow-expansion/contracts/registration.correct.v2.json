  "recovery_paths": [
    {
      "code": "POLICY_VERSION_MISMATCH",
      "trigger": "Correction cites a policy version that didn’t apply at the time",
      "from_execution_states": [
        "assessing"
      ],
      "to_execution_state": "denied",
      "retry_class": "new_approved_command",
      "fallback_ref": "proposed:fallback.policy_version_mismatch",
      "compensation_kind": "none",
      "compensation_ref": null,
      "owner": "Registrar",
      "resume_guard_refs": [
        "proposed:guard.revalidate"
      ],
      "test_ids": [
        "AT-C-POLICY"
      ]
    },
    {
      "code": "IMPACT_UNRESOLVED",
      "trigger": "Aid, prerequisite or grade impact not assessed",
      "from_execution_states": [
        "assessing"
      ],
      "to_execution_state": "denied",
      "retry_class": "new_approved_command",
      "fallback_ref": "proposed:fallback.impact_unresolved",
      "compensation_kind": "none",
      "compensation_ref": null,
      "owner": "Registrar",
      "resume_guard_refs": [
        "proposed:guard.revalidate"
      ],
      "test_ids": [
        "AT-C-IMPACT"
      ]
    },
    {
      "code": "SELF_APPROVAL",
      "trigger": "Approver is the proposer",
      "from_execution_states": [
        "awaiting_second_approver"
      ],
      "to_execution_state": "awaiting_second_approver",
      "retry_class": "no_retry",
      "fallback_ref": "proposed:fallback.self_approval",
      "compensation_kind": "none",
      "compensation_ref": null,
      "owner": "Registrar",
      "resume_guard_refs": [
        "proposed:guard.revalidate"
      ],
      "test_ids": [
        "AT-C-SELF"
      ]
    },
    {
      "code": "APPROVAL_EXPIRED",
      "trigger": "Approval older than its validity window or change edited after approval",
      "from_execution_states": [
        "awaiting_second_approver"
      ],
      "to_execution_state": "assessing",
      "retry_class": "new_approved_command",
      "fallback_ref": "proposed:fallback.approval_expired",
      "compensation_kind": "none",
      "compensation_ref": null,
      "owner": "Registrar/security",
      "resume_guard_refs": [
        "proposed:guard.revalidate"
      ],
      "test_ids": [
        "AT-C-EXPIRED"
      ]
    },
    {
      "code": "TIMEOUT_AFTER_DISPATCH",
      "trigger": "No SIS confirmation",
      "from_execution_states": [
        "dispatched"
      ],
      "to_execution_state": "reconciling",
      "retry_class": "safe_same_key",
      "fallback_ref": "proposed:fallback.timeout_after_dispatch",
      "compensation_kind": "authorized_correction",
      "compensation_ref": "proposed:compensation.timeout_after_dispatch",
      "owner": "Integration/registrar",
      "resume_guard_refs": [
        "proposed:guard.revalidate"
      ],
      "test_ids": [
        "AT-C-TIMEOUT"
      ]
    }
  ],
  "acceptance_tests": [
    {
      "id": "AT-C-HAPPY",
      "suite": "happy_path",
      "criterion": "Approved correction applied once; original enrollment and correction both visible in the ledger",
      "evidence_refs": []
    },
    {
      "id": "AT-C-POLICY",
      "suite": "authority",
      "criterion": "Correction must cite the policy version in force at the original action",
      "evidence_refs": []
    },
    {
      "id": "AT-C-IMPACT",
      "suite": "recovery",
      "criterion": "Unassessed impact blocks the correction",
      "evidence_refs": []
    },
    {
      "id": "AT-C-SELF",
      "suite": "authority",
      "criterion": "Proposer can’t approve their own correction",
      "evidence_refs": []
    },
    {
      "id": "AT-C-EXPIRED",
      "suite": "revocation",
      "criterion": "Editing after approval invalidates the approval",
      "evidence_refs": []
    },
    {
      "id": "AT-C-TIMEOUT",
      "suite": "timeout",
      "criterion": "Timeout reconciles; no duplicate correction",
      "evidence_refs": []
    },
    {
      "id": "AT-C-ISO",
      "suite": "tenant_isolation",
      "criterion": "Correction can’t touch another tenant’s records",
      "evidence_refs": []
    },
    {
      "id": "AT-C-ROLE",
      "suite": "role_denial",
      "criterion": "Students and advisors can’t open correction cases",
      "evidence_refs": []
    }
  ]
}