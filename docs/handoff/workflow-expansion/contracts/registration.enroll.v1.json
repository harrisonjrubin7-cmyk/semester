    },
    {
      "id": "t19",
      "step_id": "s4",
      "track": "execution",
      "from": "reconciling",
      "to": "committed_pending_reconciliation",
      "guard_refs": [
        "policy:registration_policy_v1"
      ],
      "audit_event": "registration.execution.committed_pending_reconciliation"
