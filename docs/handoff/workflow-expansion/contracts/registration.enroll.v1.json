      ],
      "audit_event": "registration.execution.reauthenticate"
    },
    {
      "id": "t6",
      "step_id": "s1",
      "track": "execution",
      "from": "validating",
      "to": "paused",
      "guard_refs": [
        "policy:registration_policy_v1"
      ],
      "audit_event": "registration.execution.paused"
    },
    {
      "id": "t7",
      "step_id": "s2",
      "track": "execution",
      "from": "validating",
      "to": "dispatched",
      "guard_refs": [
        "policy:registration_policy_v1"
      ],
      "audit_event": "registration.execution.dispatched"
    },
    {
      "id": "t8",
      "step_id": "s2",
      "track": "execution",
      "from": "received",
      "to": "existing_command",
      "guard_refs": [
        "policy:registration_policy_v1"
      ],
      "audit_event": "registration.execution.existing_command"
    },
    {
      "id": "t9",
      "step_id": "s2",
      "track": "execution",
      "from": "validating",
      "to": "failed",
      "guard_refs": [
        "policy:registration_policy_v1"
      ],
      "audit_event": "registration.execution.failed"
    },
    {
      "id": "t10",
      "step_id": "s3",
      "track": "execution",
      "from": "dispatched",
      "to": "completed",
      "guard_refs": [
        "policy:registration_policy_v1"
      ],
      "audit_event": "registration.execution.completed"
    },
    {
      "id": "t11",
      "step_id": "s3",
      "track": "execution",
      "from": "dispatched",
      "to": "reconciling",
      "guard_refs": [
        "policy:registration_policy_v1"
      ],
      "audit_event": "registration.execution.reconciling"
    },
    {
      "id": "t12",
      "step_id": "s3",
      "track": "execution",
      "from": "reconciling",
      "to": "completed",
      "guard_refs": [
        "policy:registration_policy_v1"
      ],
      "audit_event": "registration.execution.completed"
    },
    {
      "id": "t13",
      "step_id": "s3",
      "track": "execution",
      "from": "dispatched",
      "to": "waitlisted_or_denied",
      "guard_refs": [
        "policy:registration_policy_v1"
      ],
      "audit_event": "registration.execution.waitlisted_or_denied"
    },
    {
      "id": "t14",
      "step_id": "s3",
      "track": "execution",
      "from": "dispatched",
      "to": "committed_pending_projection",
      "guard_refs": [
        "policy:registration_policy_v1"
      ],
      "audit_event": "registration.execution.committed_pending_projection"
    },
    {
      "id": "t15",
      "step_id": "s3",
      "track": "execution",
      "from": "committed_pending_projection",
      "to": "completed",
      "guard_refs": [
        "policy:registration_policy_v1"
      ],
      "audit_event": "registration.execution.completed"
    },
    {
      "id": "t16",
      "step_id": "s3",
      "track": "execution",
      "from": "dispatched",
      "to": "failed_or_reconciling",
      "guard_refs": [
        "policy:registration_policy_v1"
      ],
      "audit_event": "registration.execution.failed_or_reconciling"
    },
    {
      "id": "t17",
      "step_id": "s3",
      "track": "execution",
      "from": "waitlisted_or_denied",
      "to": "waitlisted_or_expired",
      "guard_refs": [
        "policy:registration_policy_v1"
      ],
      "audit_event": "registration.execution.waitlisted_or_expired"
    },
    {
      "id": "t20",
      "step_id": "s3",
      "track": "business",
      "from": "requested",
      "to": "enrolled",
      "guard_refs": [
        "policy:registration_policy_v1"
      ],
      "audit_event": "registration.business.enrolled"
    },
    {
      "id": "t21",
      "step_id": "s3",
      "track": "business",
      "from": "requested",
      "to": "waitlisted",
      "guard_refs": [
        "policy:registration_policy_v1"
      ],
      "audit_event": "registration.business.waitlisted"
    },
    {
      "id": "t22",
      "step_id": "s1",
      "track": "business",
      "from": "requested",
      "to": "denied",
      "guard_refs": [
        "policy:registration_policy_v1"
      ],
      "audit_event": "registration.business.denied"
    },
    {
      "id": "t18",
      "step_id": "s4",
      "track": "execution",
      "from": "reconciling",
      "to": "correction_pending",
      "guard_refs": [
