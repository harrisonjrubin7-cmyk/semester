  ],
  "controls": {
    "risk": "consequential",
    "human_authority_required": true,
    "approval_policy_ref": "registrar/overrides#scoped-approval",
    "policy_version_ref": "registration_policy_v1",
    "idempotency": {
      "required": true,
      "key_scope": "actor+tenant",
      "payload_binding": true,
      "unknown_outcome_rule": "Reconcile with the authority before any retry; reuse the same key only if the SIS deduplicates."
    },
    "concurrency_rule_ref": "registrar/enrollment-engine#row-lock-seat",
    "provider_data_policy_ref": "no_ai_provider_access"
  },
  "recovery_paths": [
    {
      "code": "IDENTITY_TENANT_MISMATCH",
      "detection": "Stop before protected reads",
      "to_execution_state": "denied",
      "retry_policy": "never",
      "user_message": "This account doesn't have access to registration at this school. Nothing was shown or changed. If you have another school account, sign in with that one.",
      "owner": "Identity support",
      "compensation": "Denied-access audit; no protected data disclosed",
      "acceptance_test_ids": [
        "AT-IDENTITY_TENANT_MISMATCH"
      ]
    },
    {
      "code": "SOURCE_STALE_OR_UNKNOWN_AUTHORITY",
      "detection": "Block official command; refresh source and registry",
      "to_execution_state": "awaiting_information",
      "retry_policy": "safe_read",
      "user_message": "We can't confirm current registration data yet. Nothing was submitted.",
      "owner": "Registrar/integration",
      "compensation": "Freshness and writer check",
      "acceptance_test_ids": [
        "AT-SOURCE_STALE_OR_UNKNOWN_AUTHORITY"
      ]
    },
    {
      "code": "WINDOW_CLOSED",
      "detection": "Explain institution rule and next opportunity",
      "to_execution_state": "denied",
      "retry_policy": "never",
      "user_message": "Your registration window isn't open. Your next opportunity is shown.",
      "owner": "Registrar",
      "compensation": "No command committed",
      "acceptance_test_ids": [
        "AT-WINDOW_CLOSED"
      ]
    },
    {
      "code": "BLOCKING_HOLD",
      "detection": "Permitted reason plus responsible-office handoff",
      "to_execution_state": "awaiting_information",
      "retry_policy": "safe_read",
      "user_message": "A hold from the office named here needs to be cleared first.",
      "owner": "Hold-owning office",
      "compensation": "No inferred clearance from task completion",
      "acceptance_test_ids": [
        "AT-BLOCKING_HOLD"
      ]
    },
    {
      "code": "REQUISITE_OR_CREDIT_LIMIT",
      "detection": "Explain rule; scoped override request if permitted",
      "to_execution_state": "awaiting_approval",
      "retry_policy": "new_approved_command",
      "user_message": "This section has a requirement you haven't met. You can request an override if the rule allows it.",
      "owner": "Registrar/approver",
      "compensation": "Versioned rule and scoped approval",
      "acceptance_test_ids": [
        "AT-REQUISITE_OR_CREDIT_LIMIT"
      ]
    },
    {
      "code": "CAPACITY_RACE",
      "detection": "Commit-time capacity check; waitlist or alternative",
      "to_execution_state": "waitlisted_or_denied",
      "retry_policy": "never",
      "user_message": "The section filled. You're on the waitlist (or here are open alternatives).",
      "owner": "Registration operations",
      "compensation": "One final seat allocated once",
      "acceptance_test_ids": [
        "AT-CAPACITY_RACE"
      ]
    },
    {
      "code": "DUPLICATE_SAME_PAYLOAD",
      "detection": "Return original status/receipt",
      "to_execution_state": "existing_command",
      "retry_policy": "same_key_if_supported",
      "user_message": "You already sent this — here's the original receipt.",
      "owner": "Platform",
      "compensation": "One business effect",
      "acceptance_test_ids": [
        "AT-DUPLICATE_SAME_PAYLOAD"
      ]
    },
    {
      "code": "KEY_PAYLOAD_CONFLICT",
      "detection": "Reject conflict",
      "to_execution_state": "denied",
      "retry_policy": "new_approved_command",
      "user_message": "This request conflicts with one already sent. Start a new request.",
      "owner": "Platform",
      "compensation": "No changed effect",
      "acceptance_test_ids": [
        "AT-KEY_PAYLOAD_CONFLICT"
      ]
    },
    {
      "code": "TIMEOUT_AFTER_DISPATCH",
      "detection": "Result unknown; lookup authority and reconcile",
      "to_execution_state": "reconciling",
      "retry_policy": "same_key_if_supported",
      "user_message": "We're confirming the result with the registrar's system. Don't resubmit.",
      "owner": "Integration/registrar",
      "compensation": "Resolve before conflicting next command",
      "acceptance_test_ids": [
        "AT-TIMEOUT_AFTER_DISPATCH"
      ]
    },
    {
      "code": "PARTIAL_PROJECTION",
      "detection": "Retain authoritative result; repair projections",
      "to_execution_state": "committed_pending_projection",
      "retry_policy": "projection_only",
      "user_message": "Your registration went through. Some views are still updating.",
      "owner": "Integration/platform",
      "compensation": "Ledger agrees; failed projection visible",
      "acceptance_test_ids": [
        "AT-PARTIAL_PROJECTION"
      ]
    },
    {
      "code": "PRECOMMIT_FAILURE",
      "detection": "Failure with safe resume",
      "to_execution_state": "failed",
      "retry_policy": "bounded_after_no_commit",
      "user_message": "This didn't go through and nothing changed. You can try again.",
      "owner": "Platform",
      "compensation": "Evidence authority did not commit",
      "acceptance_test_ids": [
        "AT-PRECOMMIT_FAILURE"
      ]
    },
    {
      "code": "APPROVAL_EXPIRED_OR_PERMISSION_LOST",
      "detection": "Stop; request approval if permitted",
      "to_execution_state": "awaiting_approval",
      "retry_policy": "new_approved_command",
      "user_message": "The approval for this has expired. Request a new one.",
      "owner": "Registrar/security",
      "compensation": "Commit-time role and approval check",
      "acceptance_test_ids": [
        "AT-APPROVAL_EXPIRED_OR_PERMISSION_LOST"
      ]
    },
    {
      "code": "WAITLIST_OFFER_EXPIRED",
      "detection": "Record expiry under policy; show next action",
      "to_execution_state": "waitlisted_or_expired",
      "retry_policy": "never",
      "user_message": "Your waitlist offer expired. Here's what you can do next.",
      "owner": "Registration operations",
      "compensation": "Ordered waitlist; traceable offer",
      "acceptance_test_ids": [
        "AT-WAITLIST_OFFER_EXPIRED"
      ]
    },
    {
      "code": "SWAP_FAILURE",
      "detection": "Preserve original enrollment until replacement assured",
      "to_execution_state": "failed_or_reconciling",
      "retry_policy": "never",
      "user_message": "The swap didn't complete. You're still enrolled in your original section.",
      "owner": "Registrar",
      "compensation": "No unintended drop",
      "acceptance_test_ids": [
        "AT-SWAP_FAILURE"
      ]
    },
    {
      "code": "WRONG_COMMITTED_ENROLLMENT",
      "detection": "Human correction case; assess policy and impacts",
      "to_execution_state": "correction_pending",
      "retry_policy": "new_approved_command",
      "user_message": "The registrar is correcting this enrollment. The history is kept.",
      "owner": "Registrar",
      "compensation": "Original plus correction ledger",
      "acceptance_test_ids": [
        "AT-WRONG_COMMITTED_ENROLLMENT"
      ]
    },
    {
      "code": "WITHDRAWAL_REFUND_MISMATCH",
      "detection": "Retain academic decision; reconcile financial difference",
      "to_execution_state": "committed_pending_reconciliation",
      "retry_policy": "never",
      "user_message": "Your withdrawal is recorded. Student accounts is reconciling the charges.",
      "owner": "Registrar/student accounts",
      "compensation": "Separate academic and financial receipts",
      "acceptance_test_ids": [
        "AT-WITHDRAWAL_REFUND_MISMATCH"
      ]
    },
    {
      "code": "AUTHORITY_DRIFT_PAUSE",
      "detection": "Pause scope; reconcile in-flight commands and writer",
      "to_execution_state": "paused",
      "retry_policy": "never",
      "user_message": "Registration is paused while systems are reconciled. Nothing was lost.",
      "owner": "Implementation/registrar",
      "compensation": "No split-brain writer",
      "acceptance_test_ids": [
        "AT-AUTHORITY_DRIFT_PAUSE"
      ]
    }
  ],
  "completion": {
    "receipt_schema_ref": "contracts/receipt.schema.json#enrollment",
    "projection_refs": [
      "read_model.student_schedule",
      "read_model.action_center"
    ],
    "reconciliation_rule_ref": "assurance/reconciliation.yaml",
    "action_center_update_ref": "action_center.registration"
  },
  "operations": {
    "owner": "Registrar",
    "escalation_ref": "operations/support-model.yaml#tier3",
    "retention_rule_ref": "privacy/data-lifecycle.yaml#registration",
    "rollback_or_correction_ref": "s4",
    "accessibility_test_refs": [
      "a11y.registration.submit",
