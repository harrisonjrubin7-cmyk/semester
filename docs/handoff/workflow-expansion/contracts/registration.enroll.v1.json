{
  "contract_version": "1.0.0",
  "id": "registration.enroll",
  "version": 1,
  "name": "Enroll, waitlist, add/drop",
  "domain": "Registration",
  "catalog_links": [
    "B:Registration readiness",
    "E:Capacity management",
    "E:Waitlist management",
    "E:Overrides",
    "PROP-WF-004"
  ],
  "purpose": "Request enrollment in a section through the institution’s authoritative registration system with a durable receipt.",
  "trigger": "Student submits an enroll, add, drop or swap request",
  "scope": {
    "tenant_scope": "institution",
    "tenant_id": "vanderbilt",
    "allowed_roles": [
      "student",
      "registrar_staff"
    ],
    "access_basis_refs": [
      "ferpa_school_official_agreement",
      "membership:student"
    ]
  },
  "authority": {
    "mode": "assist",
    "system": "SIS",
    "registry_ref": "data/source-authority-register.yaml#enrollment",
    "official_record_write": true,
    "institution_scope": "vanderbilt",
    "activation_ref": "implementation/tenant-activation.yaml#registration",
    "effective_from": null,
    "writer_policy": "legacy_authoritative_writer"
  },
  "data": {
    "input_refs": [
      "section",
      "term",
      "time_ticket",
      "holds",
      "prerequisites",
      "cart"
    ],
    "output_refs": [
      "enrollment_receipt",
      "waitlist_position"
    ],
    "classification": [
      "education_record"
    ],
    "provenance_required": true,
    "freshness_rule_ref": "assurance/service-objectives.yaml#SLO-SOURCE-001",
    "private_official_boundary_ref": "docs/boundaries#plan-vs-enrollment"
  },
  "states": {
    "business": [
      "requested",
      "enrolled",
      "waitlisted",
      "denied"
    ],
    "execution": [
      "received",
      "validating",
      "awaiting_information",
      "awaiting_approval",
      "dispatched",
      "reconciling",
      "committed_pending_projection",
      "committed_pending_reconciliation",
      "completed",
      "existing_command",
      "reauthenticate",
      "denied",
      "waitlisted_or_denied",
      "waitlisted_or_expired",
      "failed",
      "failed_or_reconciling",
      "correction_pending",
      "paused"
    ],
    "initial_business": "requested",
    "initial_execution": "received",
    "terminal_business": [
      "enrolled",
      "waitlisted",
      "denied"
    ],
    "terminal_execution": [
      "completed",
      "existing_command",
      "denied",
      "waitlisted_or_expired",
      "failed",
      "correction_pending",
      "committed_pending_reconciliation",
      "reauthenticate",
      "paused"
    ]
  },
  "steps": [
    {
      "id": "s1",
      "name": "Validate identity, tenant, window, holds and requisites",
      "kind": "background",
      "actor_role": "system",
      "required_capabilities": [
        "registration.read"
      ],
      "surface_refs": [],
      "executor_ref": "registrar/policy.evaluate",
      "input_refs": [
        "section",
        "term",
        "time_ticket",
        "holds",
        "prerequisites"
      ],
      "output_refs": [
        "policy_decision"
      ],
      "policy_refs": [
        "registration_policy_v1"
      ],
      "audit_events": [
        "registration.validated"
      ],
      "failure_codes": [
        "IDENTITY_TENANT_MISMATCH",
        "SOURCE_STALE_OR_UNKNOWN_AUTHORITY",
        "WINDOW_CLOSED",
        "BLOCKING_HOLD",
        "REQUISITE_OR_CREDIT_LIMIT",
        "APPROVAL_EXPIRED_OR_PERMISSION_LOST",
        "AUTHORITY_DRIFT_PAUSE"
      ]
    },
    {
      "id": "s2",
      "name": "Submit request with idempotency key",
      "kind": "hybrid",
      "actor_role": "student",
      "required_capabilities": [
        "registration.submit"
      ],
      "surface_refs": [
        "B:Registration readiness"
      ],
      "executor_ref": "live-institution-command:registration.add",
      "input_refs": [
        "cart"
      ],
      "output_refs": [
        "command_receipt"
      ],
      "policy_refs": [
        "registration_policy_v1"
      ],
      "audit_events": [
        "registration.submitted"
      ],
      "failure_codes": [
        "DUPLICATE_SAME_PAYLOAD",
        "KEY_PAYLOAD_CONFLICT",
        "PRECOMMIT_FAILURE"
      ]
    },
    {
      "id": "s3",
      "name": "Dispatch to SIS and confirm",
      "kind": "background",
      "actor_role": "system",
      "required_capabilities": [
        "sis.write.registration"
      ],
      "surface_refs": [],
      "executor_ref": "outbox/publisher → sis adapter",
      "input_refs": [
        "command_receipt"
      ],
      "output_refs": [
        "enrollment_receipt",
        "waitlist_position"
      ],
      "policy_refs": [
        "registration_policy_v1"
      ],
      "audit_events": [
        "registration.dispatched",
        "registration.confirmed"
      ],
      "failure_codes": [
        "CAPACITY_RACE",
        "TIMEOUT_AFTER_DISPATCH",
        "PARTIAL_PROJECTION",
        "SWAP_FAILURE",
        "WAITLIST_OFFER_EXPIRED"
      ]
    },
    {
      "id": "s4",
      "name": "Registrar correction",
      "kind": "operational_review",
      "actor_role": "registrar_staff",
      "required_capabilities": [
        "registration.correct"
      ],
      "surface_refs": [
        "E:Overrides"
      ],
      "executor_ref": null,
      "input_refs": [
        "enrollment_receipt"
      ],
      "output_refs": [
        "correction_record"
      ],
      "policy_refs": [
        "registration_policy_v1"
      ],
      "audit_events": [
        "registration.corrected"
      ],
      "failure_codes": [
        "WRONG_COMMITTED_ENROLLMENT",
        "WITHDRAWAL_REFUND_MISMATCH"
      ]
    }
  ],
  "transitions": [
    {
      "id": "t1",
      "step_id": "s1",
      "track": "execution",
      "from": "received",
      "to": "validating",
      "guard_refs": [
        "policy:registration_policy_v1"
      ],
      "audit_event": "registration.execution.validating"
    },
    {
      "id": "t2",
      "step_id": "s1",
      "track": "execution",
      "from": "validating",
      "to": "awaiting_information",
      "guard_refs": [
        "policy:registration_policy_v1"
      ],
      "audit_event": "registration.execution.awaiting_information"
    },
    {
      "id": "t3",
      "step_id": "s1",
      "track": "execution",
      "from": "validating",
      "to": "awaiting_approval",
      "guard_refs": [
