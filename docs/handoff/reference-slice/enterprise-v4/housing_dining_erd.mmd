%% Housing + dining logical ERD (from "Higher-ed ERP database schema" PDF part 2, 6 Oct). Logical only: Mermaid does not enforce
%% tenant isolation, uniqueness or concurrency. SQL in 010/011 is authoritative. All tenant tables key on (tenant_id, id).
erDiagram
  INSTITUTIONS {
    uuid id PK
    string name
    string slug UK
    string default_timezone
    string status
  }
  CAMPUSES {
    uuid tenant_id PK, FK
    uuid id PK
    string name
    string timezone
    string status
  }
  PEOPLE {
    uuid tenant_id PK, FK
  }
