{
  "openapi": "3.1.0",
  "info": {
    "title": "Synthetic validator self-test",
    "version": "0.1"
  },
  "paths": {
    "/registration": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "operation": {
                        "const": "add"
                      },
                      "sectionIds": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "format": "uuid"
                        }
                      }
                    },
                    "required": [
                      "operation",
                      "sectionIds"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "operation": {
                        "const": "drop"
                      },
                      "fromEnrollmentIds": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "format": "uuid"
                        }
                      }
                    },
                    "required": [
                      "operation",
                      "fromEnrollmentIds"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "operation": {
                        "const": "swap"
                      },
                      "sectionIds": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "format": "uuid"
                        }
                      },
                      "fromEnrollmentIds": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "format": "uuid"
                        }
                      }
                    },
                    "required": [
                      "operation",
                      "sectionIds",
                      "fromEnrollmentIds"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "operation": {
                        "const": "withdraw"
                      },
                      "fromEnrollmentIds": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "format": "uuid"
                        }
                      }
                    },
                    "required": [
                      "operation",
                      "fromEnrollmentIds"
                    ]
                  }
                ],
                "discriminator": {
                  "propertyName": "operation"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Synthetic response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "receiptId": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "uuid"
                    },
                    "state": {
                      "enum": [
                        "confirmed",
                        "pending"
                      ]
                    }
                  },
                  "required": [
                    "receiptId",
                    "state"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}