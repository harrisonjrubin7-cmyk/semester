                }
              }
            }
          },
          "429": {
            "description": "Rate limit",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable before acceptance",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/academic/students/{studentId}/enrollments": {
      "get": {
        "operationId": "listEnrollments",
        "parameters": [
          {
            "name": "studentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "termId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Scoped paginated enrollments",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Enrollment"
                      }
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "items",
                    "nextCursor"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Malformed input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Invalid authentication",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Not permitted",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Absent or undisclosed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency or domain conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "412": {
            "description": "Version conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid operation semantics",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable before acceptance",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-pagination": "Opaque, tenant- and actor-scoped cursor; invalid or foreign cursor → 400 without revealing whether resources exist."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Validate issuer,audience,signature,expiry and current server-side grants. Workload identities have separate restricted scopes."
      }
    },
    "schemas": {
      "EnrollmentCommand": {
        "description": "One branch per operation. Irrelevant fields are rejected (additionalProperties:false). Idempotency key is the Idempotency-Key header, never a body field. studentId must equal the authenticated student unless registrar staff act under a scoped grant (handler check).",
        "discriminator": {
          "propertyName": "operation"
        },
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "studentId",
              "termId",
              "operation",
              "expectedScheduleVersion",
              "sectionIds"
            ],
            "properties": {
              "studentId": {
                "type": "string",
                "format": "uuid"
              },
              "termId": {
                "type": "string",
                "format": "uuid"
              },
              "expectedScheduleVersion": {
                "type": "integer",
                "minimum": 0
              },
              "overrideIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                },
                "maxItems": 5,
                "uniqueItems": true
              },
              "operation": {
                "const": "add"
              },
              "sectionIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                },
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "studentId",
              "termId",
              "operation",
              "expectedScheduleVersion",
              "fromEnrollmentIds"
            ],
            "properties": {
              "studentId": {
                "type": "string",
                "format": "uuid"
              },
              "termId": {
                "type": "string",
                "format": "uuid"
              },
              "expectedScheduleVersion": {
                "type": "integer",
                "minimum": 0
              },
              "overrideIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                },
                "maxItems": 5,
                "uniqueItems": true
              },
              "operation": {
                "const": "drop"
              },
              "fromEnrollmentIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                },
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "studentId",
              "termId",
              "operation",
              "expectedScheduleVersion",
              "fromEnrollmentIds",
              "sectionIds"
            ],
            "properties": {
              "studentId": {
                "type": "string",
                "format": "uuid"
              },
              "termId": {
                "type": "string",
                "format": "uuid"
              },
              "expectedScheduleVersion": {
                "type": "integer",
                "minimum": 0
              },
              "overrideIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                },
                "maxItems": 5,
                "uniqueItems": true
              },
              "operation": {
                "const": "swap"
              },
              "fromEnrollmentIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                },
                "minItems": 1,
                "maxItems": 1,
                "uniqueItems": true
              },
              "sectionIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                },
                "minItems": 1,
                "maxItems": 1,
                "uniqueItems": true
              }
            },
            "description": "One-for-one swap, matching registration_swap(from, to): drop and add commit together or not at all."
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "studentId",
              "termId",
              "operation",
              "expectedScheduleVersion",
              "fromEnrollmentIds",
              "withdrawalReasonCode"
            ],
            "properties": {
              "studentId": {
                "type": "string",
                "format": "uuid"
              },
              "termId": {
                "type": "string",
                "format": "uuid"
              },
              "expectedScheduleVersion": {
                "type": "integer",
                "minimum": 0
              },
              "overrideIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                },
                "maxItems": 5,
                "uniqueItems": true
              },
              "operation": {
                "const": "withdraw"
              },
              "fromEnrollmentIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                },
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true
              },
              "withdrawalReasonCode": {
                "type": "string",
                "maxLength": 40
              }
            }
          }
        ]
      },
      "Operation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "accepted",
              "blocked",
              "pending",
              "confirmed",
              "reconcile_required",
              "failed"
            ]
          },
          "receiptId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "correlationId": {
            "type": "string"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "projectionState": {
            "type": "string",
            "enum": [
              "updating",
              "current",
              "stale",
              "unavailable"
            ]
          }
        },
        "required": [
          "id",
          "state",
          "correlationId",
          "reasons"
        ]
      },
      "Enrollment": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "studentId": {
            "type": "string",
            "format": "uuid"
          },
          "sectionId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "enrolled",
              "dropped",
              "withdrawn",
              "completed",
              "cancelled"
            ]
          },
          "credits": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]{1,3})?$"
          },
          "gradeMode": {
            "type": "string"
          },
          "recordVersion": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "studentId",
          "sectionId",
          "status",
          "credits",
          "gradeMode",
          "recordVersion"
        ]
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "operationId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        },
        "required": [
          "status",
          "code",
          "title",
          "correlationId",
          "retryable"
        ]
      }
    }
  }
}