{
  "openapi": "3.1.0",
  "info": {
    "title": "Semester proposed enrollment contract",
    "version": "0.1.0",
    "description": "Reference contract, not implemented endpoint evidence. No servers declared until target resolved."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/academic/registration-requests": {
      "post": {
        "operationId": "submitEnrollmentCommand",
        "description": "Trusted actor/tenant resolved server-side. Atomic swap; recheck policy and capacity. Same actor/key/payload returns original operation; changed payload is 409. 202 is durable acceptance, not enrollment. Field combinations validated per operation. External timeout after dispatch becomes reconcile_required.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 200
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnrollmentCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing idempotent operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Operation"
                }
              }
            }
          },
          "202": {
            "description": "Durable acceptance — not enrollment. Poll Location until a terminal state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Operation"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "/v1/academic/operations/{operationId}",
                "schema": {
                  "type": "string"
                }
              },
              "Retry-After": {
                "description": "Suggested poll interval in seconds",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "400": {
            "description": "Malformed input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or invalid",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                },
                "description": "Bearer realm=\"semester\", error=\"invalid_token\""
              }
            }
          },
          "403": {
            "description": "Not permitted",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Absent or undisclosed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency or domain conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "412": {
            "description": "Version conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid operation semantics",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable before acceptance",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-request-limits": {
          "maxBodyBytes": 16384,
          "credits": "decimal string with ≤3 fractional digits where used"
        },
        "x-auth": "Server verifies JWT issuer, audience, signature (rotating JWKS), expiry and revocation, then re-reads membership, purpose and integration mode at execution time. Client role claims are never trusted.",
        "x-timeout-rule": "Timeout after dispatch → state reconcile_required with the same operationId. Never re-dispatch."
      }
    },
    "/v1/academic/operations/{operationId}": {
