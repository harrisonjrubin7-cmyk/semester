# Public (safe for the browser). Find both in Supabase: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: canonical site URL used in magic-link redirects (defaults to the request origin).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Never add a service-role / secret key to this app. Nothing here needs one:
# every query runs as the signed-in user and Row Level Security does the authorization.
