{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": "app",
      "framework": "vite"
    },
    "workflow-lab": {
      "root": "workflow-lab",
      "framework": "nextjs",
      "installCommand": "npm ci",
      "buildCommand": "npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/lab",
      "destination": {
        "service": "workflow-lab"
      }
    },
    {
      "source": "/lab/(.*)",
      "destination": {
        "service": "workflow-lab"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
