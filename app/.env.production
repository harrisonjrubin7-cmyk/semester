# Build defaults for the deployed app.
#
# Committed on purpose. Both values are public by design: the built JavaScript
# contains them whichever way they are supplied, which is what "publishable"
# means. Security comes from the row-level policies in supabase/schema.sql —
# every table demands auth.uid() = user_id — not from hiding these.
#
# The secret / service key is a different thing entirely and must never appear
# here, in the repo, or in a build variable. The app has no use for it.
#
# A fork pointing at its own project sets VITE_SUPABASE_URL and
# VITE_SUPABASE_KEY as repository variables; those win over this file.
VITE_SUPABASE_URL=https://lzrqvlugnawcgywkhqlz.supabase.co
VITE_SUPABASE_KEY=sb_publishable_aU09VKFZdGCrO-RM_rVzMQ_j17FqKRj

# The AI Toolkit (app/src/lib/toolkit/flags.ts), switched on for the deployed
# app. Everything the toolkit stores stays on the student's device; code
# execution and external connectors stay off whatever is set here, because
# nothing is built behind them.
#
# Kill switch without a commit: set the repository variable VITE_AI_TOOLKIT
# to `off`. A repository variable wins over this file, and `off` forces every
# other toolkit flag off. See docs/ai-toolkit/AI-TOOLKIT-FEATURE-FLAGS.md.
VITE_AI_TOOLKIT=production
VITE_TOOLKIT_RESEARCH=production
VITE_TOOLKIT_DATA=production
VITE_TOOLKIT_DATA_UPLOAD=production
VITE_TOOLKIT_WORKBENCHES=production
VITE_TOOLKIT_DISCLOSURE=production

# Public OAuth client registered for the production Semester web app.
# Repository variables can override this deployment default.
VITE_GOOGLE_CLIENT_ID=1064704869348-70m588lh21lg715ufi5j0smsk67uqj43.apps.googleusercontent.com

VITE_MS_CLIENT_ID=ba5a7f39-e3be-4ab3-b450-67fa80faecad
