{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /*
     * The shared data contract, imported rather than copied.
     *
     * `packages/contract` is one module with two consumers — this app and the
     * desktop client. A copy in each is exactly how the two shapes drifted
     * apart in the first place, so it is aliased in rather than vendored.
     */
    "paths": {
      "@semester/contract": ["../packages/contract/src/index.ts"],
      /*
       * The gateway contract, on the same terms and for the same reason.
       *
       * A separate module rather than a folder inside the one above: that one
       * is this app's own records on the wire between its own clients, this
       * one is what a university's server is asked and answers. Three things
       * must agree on it exactly — the browser, `server/institution`, and the
       * tests between them — so it is aliased in rather than copied.
       */
      "@semester/institution": ["../packages/institution/src/index.ts"],
      /*
       * The offline and sync core: queue, protocol, conflict rules, device
       * lease, key hierarchy, attachment cache and CRDT. Platform-neutral and
       * dependency-free, so a phone, the PWA and the tests all run the same code.
       */
      "@semester/offline-sync": ["../packages/offline-sync/src/index.ts"],
      /*
       * The platform primitives: tenancy, policy evaluation, the command
       * pipeline, and the engines every domain shares. Imported through this
       * alias by the app and the gateway so there is one copy of the
       * tenant boundary, not one per caller.
       */
      "@semester/platform": ["../packages/platform/src/index.ts"]
    }
  },
  "include": ["src", "../packages/contract/src", "../packages/institution/src", "../packages/offline-sync/src", "../packages/platform/src"]
}
