# Server environment ONLY. Never prefix any of these with VITE_.
#
# A VITE_ variable is compiled into the browser bundle and served to everyone.
# Every value below is a secret or a server address; the client's only
# university setting is VITE_UNIVERSITY_GATEWAY_URL, which is a public address
# and belongs in the app's own environment rather than here.

# The exact origin the app is served from. Must be https, or localhost while
# developing. The gateway refuses any other origin.
SEMESTER_APP_ORIGIN=http://localhost:5173
SEMESTER_GATEWAY_PORT=8787
SEMESTER_INSTITUTION_NAME=Your university

# The same Supabase Auth project the Semester client signs in against —
# tokens are validated over the network against it, not decoded locally.
SEMESTER_AUTH_URL=
SEMESTER_AUTH_PUBLIC_KEY=
# Server-only service-role key used to resolve current institutional
# memberships. Never expose this value through VITE_ or a browser response.
SEMESTER_AUTH_SERVICE_KEY=

# Public discovery values, never metadata XML or credentials. The gateway
# still returns SSO disabled unless its database contains exactly one
# authorized SAML provider whose domains include this domain.
SEMESTER_SSO_LABEL=Vanderbilt
SEMESTER_SSO_DOMAIN=vanderbilt.edu

# Thirty-two random bytes as hex. Generate once:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
#
# Keep it. It decrypts prepared actions and receipts across a restart, and
# losing it means losing the record of what was sent to the institution.
SEMESTER_JOURNAL_KEY=

# Development defaults to the single-process SQLite journal and memory rate
# limiter. Every horizontally scaled or serverless Preview/Production runtime
# must use postgres so action claims, AI confirmations and request limits are
# shared atomically between instances.
SEMESTER_GATEWAY_STORE=sqlite

# Somewhere private and persistent — never under public/, dist/, or anything
# the website serves.
SEMESTER_JOURNAL_PATH=work/university/private/actions.sqlite

# Optional governed intelligence policy. Leave blank to keep the gateway's
# intelligence routes policy-disabled. These names are server-only and are
# never exposed through VITE_ variables.
OPENAI_API_KEY=
# Exact operator-approved routes. Every entry must also be allowed by the
# tenant's ai_policy.allowed_providers row and feature policy.
SEMESTER_AI_PROVIDERS=openai:gpt-5-mini
# Reserve this estimate atomically before a request. It may not exceed the
# per-request ceiling; the tenant's monthly cap remains authoritative in DB.
SEMESTER_AI_ESTIMATED_REQUEST_CENTS=1
SEMESTER_AI_MAX_REQUEST_CENTS=2
# Omit or use "sandbox" until institutional provider, privacy and legal review
# is complete. "production" changes operational health labeling, never policy.
SEMESTER_AI_RUNTIME_STATUS=sandbox
