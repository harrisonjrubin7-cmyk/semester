# Copy to .env.local and fill in what you have. Everything here is optional:
# without any of it the app runs, and the Connect screen offers the file route
# (an exported .ics) instead of a sign-in.
#
# .env.local is gitignored. Nothing in here is a secret in the usual sense —
# an OAuth client ID for a public client is meant to be visible — but a client
# ID is still tied to whoever registered it, so keep it out of commits.

# Microsoft 365 — portal.azure.com → App registrations → new registration.
# Platform: Single-page application. Redirect URI: http://localhost:5199
VITE_MS_CLIENT_ID=

# Google — console.cloud.google.com → APIs & Services → Credentials →
# OAuth client ID → Web application. Authorised origin and redirect:
# http://localhost:5199
VITE_GOOGLE_CLIENT_ID=

# Zoom — marketplace.zoom.us → Develop → Build App → General App, PKCE enabled.
# Zoom's API sends no CORS headers, so this one needs the proxy below.
VITE_ZOOM_CLIENT_ID=

# The dev server forwards token exchanges and Zoom's API (see vite.config.ts).
# Leave it unset to talk to Microsoft and Google directly, which they allow for
# a registered single-page app.
VITE_OAUTH_PROXY=/oauth
