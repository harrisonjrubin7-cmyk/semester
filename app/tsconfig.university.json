{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@semester/platform": ["../packages/platform/src/index.ts"]
    },
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["server/institution/**/*.ts", "server/integration/**/*.ts", "server/productivity/**/*.ts", "api/institution/**/*.ts", "../packages/institution/**/*.ts", "../packages/platform/**/*.ts"]
}
