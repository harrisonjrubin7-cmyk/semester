{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --max-warnings=25 src && node scripts/styles.mjs && node scripts/labels.mjs",
    "lint:styles": "node scripts/styles.mjs",
    "counts": "node scripts/counts.mjs",
    "icons": "node scripts/icons.mjs",
    "mirror": "node scripts/mirror.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:zones": "TZ=America/Chicago vitest run && TZ=Pacific/Kiritimati vitest run",
    "test:shuffle": "vitest run --sequence.shuffle",
    "lint:labels": "node scripts/labels.mjs",
    "sweep:contrast": "node scripts/contrast-sweep.mjs",
    "sweep:targets": "node scripts/targets-sweep.mjs",
    "smoke:gateway": "node scripts/gateway-smoke.mjs",
    "transcripts": "node scripts/transcripts.mjs",
    "audio": "node scripts/audio.ts",
    "check:university": "tsc -p tsconfig.university.json",
    "check:video": "tsc -p ../video/tsconfig.json",
    "dev:university": "node --env-file=server/institution/.env server/institution/start.ts",
    "sweep:walls": "node scripts/wallsweep.mjs",
    "smoke:cold": "node scripts/cold-smoke.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.114.0",
    "@types/leaflet": "^1.9.22",
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4",
    "mermaid": "^11.17.2",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "jsqr": "^1.4.0",
    "oxlint": "^1.79.0",
    "qrcode-generator": "^2.0.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
